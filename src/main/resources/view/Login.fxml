<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ijse.therapycenter.controller.LoginController"
            prefWidth="420" prefHeight="320"
            style="-fx-background-color: #f0f4f8;">

    <VBox alignment="CENTER" spacing="14"
          AnchorPane.topAnchor="30" AnchorPane.bottomAnchor="30"
          AnchorPane.leftAnchor="60" AnchorPane.rightAnchor="60">

        <Label text="Serenity Mental Health Therapy Center"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <Label text="Please log in to continue"
               style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>

        <TextField fx:id="txtUsername" promptText="Username" maxWidth="280"/>

        <!-- Password hidden by default -->
        <PasswordField fx:id="txtPassword" promptText="Password" maxWidth="280"/>

        <!-- Password shown when checkbox is ticked -->
        <TextField fx:id="txtPasswordVisible" promptText="Password"
                   maxWidth="280" visible="false" managed="false"/>

        <CheckBox fx:id="chkShowPassword" text="Show password"/>

        <Label fx:id="lblError" text="" style="-fx-text-fill: red; -fx-font-size: 11px;"/>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Login" prefWidth="120" onAction="#onLoginClicked"
                    style="-fx-background-color: #2980b9; -fx-text-fill: white;"/>
            <Button text="Clear" prefWidth="80" onAction="#onClearClicked"/>
        </HBox>

    </VBox>
</AnchorPane>
