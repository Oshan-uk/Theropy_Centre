<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620" prefWidth="900" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.ijse.therapycenter.controller.AdminDashboardController">

    <!-- Top bar -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2c3e50; -fx-padding: 12 20;">
            <Label style="-fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="🏥 Serenity Therapy Center — Admin" />
            <Label fx:id="lblWelcome" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;" />
        </HBox>
    </top>

    <!-- Left sidebar navigation -->
    <left>
        <VBox prefWidth="180" spacing="4" style="-fx-background-color: #34495e; -fx-padding: 20 0;">
            <Button onAction="#onTherapistsClicked" prefWidth="180" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT; -fx-padding: 10 20;" text="👨‍⚕️  Therapists" />
         <Button layoutX="10.0" layoutY="30.0" onAction="#onTherapistsClicked" prefWidth="180" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT; -fx-padding: 10 20;" text="👨‍⚕️  Patients" />
            <Button onAction="#onProgramsClicked" prefWidth="180" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT; -fx-padding: 10 20;" text="📋  Programs" />
            <Button onAction="#onReportsClicked" prefWidth="180" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT; -fx-padding: 10 20;" text="📊  Reports" />
            <Button onAction="#onProfileClicked" prefWidth="180" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: CENTER-LEFT; -fx-padding: 10 20;" text="👤  My Profile" />
            <Button onAction="#onLogoutClicked" prefWidth="180" style="-fx-background-color: transparent; -fx-text-fill: #e74c3c; -fx-alignment: CENTER-LEFT; -fx-padding: 10 20;" text="🚪  Logout" />
        </VBox>
    </left>

    <!-- Center — sub-screens load here -->
    <center>
        <AnchorPane fx:id="contentPane" style="-fx-background-color: #ecf0f1; -fx-padding: 20;">
            <Label style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" text="Select a menu item to get started." AnchorPane.leftAnchor="20" AnchorPane.topAnchor="20" />
        </AnchorPane>
    </center>

</BorderPane>
