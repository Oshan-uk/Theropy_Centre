<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ijse.therapycenter.controller.TherapyProgramController"
            prefWidth="860" prefHeight="520">

    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

        <Label text="Therapy Program Management"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <GridPane hgap="12" vgap="10">
            <Label text="Program ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtProgramId" prefWidth="150" promptText="e.g. MT1006"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Program Name:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtProgramName" prefWidth="220"
                       GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Duration:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtDuration" prefWidth="150" promptText="e.g. 8 weeks"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Fee (LKR):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtFee" prefWidth="220"
                       GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextArea fx:id="txtDescription" prefWidth="400" prefHeight="60" wrapText="true"
                      GridPane.columnIndex="1" GridPane.rowIndex="2"
                      GridPane.columnSpan="3"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Save" prefWidth="100" onAction="#onSaveClicked"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            <Button text="Delete" prefWidth="100" onAction="#onDeleteClicked"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            <Button text="Clear" prefWidth="100" onAction="#onClearClicked"/>
            <Label fx:id="lblMessage" text=""/>
        </HBox>

        <TableView fx:id="tblPrograms" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="Program ID" prefWidth="100"/>
                <TableColumn fx:id="colName" text="Program Name" prefWidth="220"/>
                <TableColumn fx:id="colDuration" text="Duration" prefWidth="120"/>
                <TableColumn fx:id="colFee" text="Fee (LKR)" prefWidth="120"/>
            </columns>
        </TableView>

    </VBox>
</AnchorPane>
