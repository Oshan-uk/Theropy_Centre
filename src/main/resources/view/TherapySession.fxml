<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ijse.therapycenter.controller.TherapySessionController"
            prefWidth="860" prefHeight="580">

    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

        <Label text="Therapy Session Scheduling"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <GridPane hgap="12" vgap="10">
            <Label text="Patient:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbPatient" prefWidth="200"
                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Therapist:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbTherapist" prefWidth="200"
                      GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Program:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbProgram" prefWidth="200"
                      GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Session Date:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpSessionDate" prefWidth="200"
                        GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Time (HH:mm):" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtSessionTime" prefWidth="200" promptText="e.g. 09:30"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Notes:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
            <TextArea fx:id="txtNotes" prefWidth="200" prefHeight="60"
                      GridPane.columnIndex="3" GridPane.rowIndex="2"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Book / Reschedule" prefWidth="140" onAction="#onBookClicked"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            <Button text="Cancel Session" prefWidth="130" onAction="#onCancelSessionClicked"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            <Label fx:id="lblMessage" text=""/>
        </HBox>

        <TableView fx:id="tblSessions" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colPatient" text="Patient" prefWidth="150"/>
                <TableColumn fx:id="colTherapist" text="Therapist" prefWidth="150"/>
                <TableColumn fx:id="colProgram" text="Program" prefWidth="170"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
            </columns>
        </TableView>

    </VBox>
</AnchorPane>
