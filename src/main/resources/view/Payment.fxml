<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ijse.therapycenter.controller.PaymentController"
            prefWidth="860" prefHeight="580">

    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

        <Label text="Payment &amp; Invoice Management"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <GridPane hgap="12" vgap="10">
            <Label text="Patient:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbPatient" prefWidth="200"
                      GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Session:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbSession" prefWidth="250"
                      GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Amount (LKR):" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtAmount" prefWidth="200"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Payment Method:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <ComboBox fx:id="cmbPaymentMethod" prefWidth="200"
                      GridPane.columnIndex="3" GridPane.rowIndex="1"/>
        </GridPane>

        <Label fx:id="lblInvoice" text=""
               style="-fx-font-weight: bold; -fx-text-fill: #27ae60;"/>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Process Payment" prefWidth="140" onAction="#onProcessPaymentClicked"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            <Button text="Mark as Paid" prefWidth="120" onAction="#onMarkPaidClicked"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
            <Button text="Show Pending" prefWidth="120" onAction="#onShowPendingClicked"
                    style="-fx-background-color: #8e44ad; -fx-text-fill: white;"/>
            <Button text="Show All" prefWidth="100" onAction="#onShowAllClicked"/>
            <Label fx:id="lblMessage" text=""/>
        </HBox>

        <TableView fx:id="tblPayments" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="45"/>
                <TableColumn fx:id="colPatient" text="Patient" prefWidth="140"/>
                <TableColumn fx:id="colAmount" text="Amount (LKR)" prefWidth="120"/>
                <TableColumn fx:id="colDate" text="Date" prefWidth="110"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                <TableColumn fx:id="colMethod" text="Method" prefWidth="100"/>
                <TableColumn fx:id="colInvoice" text="Invoice No." prefWidth="140"/>
            </columns>
        </TableView>

    </VBox>
</AnchorPane>
