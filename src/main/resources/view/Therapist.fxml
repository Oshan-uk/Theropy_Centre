<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="lk.ijse.therapycenter.controller.TherapistController"
            prefWidth="860" prefHeight="560">

    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10"
          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">

        <Label text="Therapist Management"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

        <GridPane hgap="12" vgap="10">
            <Label text="Full Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtName" prefWidth="220"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Email:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtEmail" prefWidth="220"
                       GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Phone:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtPhone" prefWidth="220"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Specialization:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtSpecialization" prefWidth="220"
                       GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Available:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <CheckBox fx:id="chkAvailable" selected="true"
                      GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Save" prefWidth="100" onAction="#onSaveClicked"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
            <Button text="Delete" prefWidth="100" onAction="#onDeleteClicked"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
            <Button text="Clear" prefWidth="100" onAction="#onClearClicked"/>
            <Label fx:id="lblMessage" text=""/>
        </HBox>

        <TableView fx:id="tblTherapists" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colName" text="Full Name" prefWidth="160"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                <TableColumn fx:id="colPhone" text="Phone" prefWidth="120"/>
                <TableColumn fx:id="colSpec" text="Specialization" prefWidth="180"/>
                <TableColumn fx:id="colAvailable" text="Available" prefWidth="80"/>
            </columns>
        </TableView>

    </VBox>
</AnchorPane>
